# ==============================================================================
# SportConnect - Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env.local e preencha os valores antes de rodar o projeto.
# ==============================================================================

# Supabase (Configuração Pública)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (Chave Administrativa - NUNCA expor ao cliente ou usar com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (Gateway de Pagamentos e Webhooks Pix)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Regras e Configurações Gerais
NEXT_PUBLIC_TOURNAMENT_TYPE=SINGLE_ELIMINATION

